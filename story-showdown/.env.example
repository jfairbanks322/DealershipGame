# Local development defaults. Railway injects PORT automatically.
PORT=3040
HOST=0.0.0.0

# Optional. When a Railway Volume is attached, RAILWAY_VOLUME_MOUNT_PATH is
# detected automatically and games.json is stored there.
# STORY_SHOWDOWN_DATA_FILE=./data/games.json

# Maximum number of classroom games retained by this single service.
MAX_GAMES=100
