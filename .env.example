# Node does not automatically load this file. Export variables in your shell
# or add them in the Railway service's Variables panel.
PORT=3040
# Required on Railway: use a private teacher key of at least 12 characters.
# Local development defaults to classroom-local if this variable is unset.
TEACHER_KEY=replace-with-a-private-teacher-key
# Local only, optional. Production always stores its DB on the Railway volume.
# DB_PATH=/absolute/path/business-math.db
# Railway sets RAILWAY_VOLUME_MOUNT_PATH automatically when a volume is attached.
